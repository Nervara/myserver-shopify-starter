# Copy to .env for local dev. On myserver, set these in the app's Variables
# panel instead (SHOPIFY_API_KEY / SHOPIFY_API_SECRET as secrets).

# From your Shopify Partner dashboard → Apps → your app → API credentials.
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret

# Comma-separated access scopes your app needs.
SCOPES=write_products

# The app's PUBLIC HTTPS URL. Must match the App URL + allowed redirect URL
# in the Partner dashboard. On myserver this is the FQDN from the Domains
# panel, e.g. https://shopify-app.<server-ip>.sslip.io or your custom domain.
SHOPIFY_APP_URL=https://your-app-url

# Postgres connection string. On myserver, create a Postgres database resource
# and use its internal connection string (the template wires this for you).
DATABASE_URL=postgresql://user:password@host:5432/shopify_app

# Port the server listens on (myserver maps this; keep 3000 unless you change it).
PORT=3000
